DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Use the full request path so the redirect stays correct under / and /new/.
  # A relative target here makes Apache build the URL from the disk path (404).
  RewriteCond %{REQUEST_URI} ^(.*/projects/dwa/)index[.]php$
  RewriteRule ^index[.]php$ %1 [R=301,L]
</IfModule>
